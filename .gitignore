# Legacy Super Productivity plugin — local read-only reference, never shipped.
# Stays untracked until the useful parts are extracted into docs/.
legacy/

# Dependencies
node_modules/

# Portable Node, fetched by run.cmd when there is none on PATH. Safe to delete.
.node/

# Build output
dist/
out/
release/
*.zip

# Local runtime data (never commit — may contain Jira credentials)
userData/
logs/
*.log
*.log.1

# Development credential preset. Contains a real Jira API token in plain text,
# so it must never leave the machine that created it. Template: .joggl-dev.example.json
.joggl-dev.json

# Env / secrets
.env
.env.*

# OS & editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Claude Code local overrides
.claude/settings.local.json

# Brainstorming companion mockups — working material, not part of the app.
.superpowers/
